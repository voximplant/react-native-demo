{
  "name": "react-native-dev-app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "doctor": "react-native doctor",
    "typecheck": "tsc --noEmit",
    "start": "react-native start",
    "start:reset-cache": "react-native start --reset-cache",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "deintegrate": "cd ios && pod deintegrate",
    "clean:android": "del-cli android/build android/app/build",
    "clean:ios": "del-cli ios/build",
    "clean": "del-cli android/build android/app/build ios/build",
    "gen:android": "cd android && ./gradlew generateCodegenArtifactsFromSchema",
    "gen:ios": "cd ios && RCT_NEW_ARCH_ENABLED=1 bundle exec pod install",
    "gen:ios:update": "cd ios && RCT_NEW_ARCH_ENABLED=1 bundle exec pod install --repo-update",
    "gen": "concurrently --names 'gen:android,gen:ios' -c 'yellow,blue' 'yarn gen:android' 'yarn gen:ios'",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --mode Debug",
    "bootstrap": "bundle install"
  },
  "dependencies": {
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@hookform/resolvers": "5.9.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@voximplant/react-native-calls": "2.0.0",
    "@voximplant/react-native-core": "2.0.0",
    "blueimp-md5": "^2.19.0",
    "immer": "^11.1.8",
    "lucide-react-native": "^1.18.0",
    "react": "19.2.3",
    "react-hook-form": "7.87.0",
    "react-native": "0.87.1",
    "react-native-keyboard-controller": "1.22.5",
    "react-native-permissions": "5.6.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.27.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "0.12.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/blueimp-md5": "^2.18.2",
    "@types/react": "~19.2.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "del-cli": "^7.0.0",
    "react-native-builder-bob": "^0.40.13",
    "react-native-monorepo-config": "^0.3.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
