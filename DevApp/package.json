{
  "name": "react-native-dev-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "doctor": "react-native doctor",
    "typecheck": "tsc --noEmit",
    "start": "react-native start",
    "start:reset-cache": "react-native start --reset-cache",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "deintegrate": "cd ios && pod deintegrate",
    "clean:android": "del-cli android/build android/app/build",
    "clean:ios": "del-cli ios/build",
    "clean": "del-cli android/build android/app/build ios/build",
    "gen:android": "cd android && ./gradlew generateCodegenArtifactsFromSchema",
    "gen:ios": "cd ios && RCT_NEW_ARCH_ENABLED=1 bundle exec pod install",
    "gen:ios:update": "cd ios && RCT_NEW_ARCH_ENABLED=1 bundle exec pod install --repo-update",
    "gen": "concurrently --names 'gen:android,gen:ios' -c 'yellow,blue' 'yarn gen:android' 'yarn gen:ios'",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --mode Debug",
    "bootstrap": "bundle install"
  },
  "dependencies": {
    "@babel/plugin-transform-export-namespace-from": "7.27.1",
    "@hookform/resolvers": "7.0.5",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@voximplant/react-native-calls": "2.0.0",
    "@voximplant/react-native-core": "2.0.0",
    "blueimp-md5": "2.19.0",
    "immer": "11.2.10",
    "lucide-react-native": "1.71.0",
    "react": "19.3.0",
    "react-hook-form": "7.91.0",
    "react-native": "0.88.1",
    "react-native-keyboard-controller": "1.23.0",
    "react-native-permissions": "5.6.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-worklets": "0.13.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.13",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/blueimp-md5": "2.18.2",
    "@types/react": "19.3.0",
    "babel-plugin-module-resolver": "5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "10.0.7",
    "del-cli": "8.0.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
